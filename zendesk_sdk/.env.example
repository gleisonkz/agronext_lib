# Copie para .env e preencha com seus valores:
#   copy .env.example .env
#
# O .env NAO deve ser commitado (esta no .gitignore).
#
# Para criar/atualizar forms e campos na instancia Zendesk:
#   python poc_zendesk.py setup
# (idempotente — reutiliza o que ja existe e atualiza os IDs abaixo)

# --- Obrigatorio ---

ZENDESK_SUBDOMAIN=essorhelp1770893829
ZENDESK_EMAIL=seu-email@empresa.com
ZENDESK_TOKEN=

# --- Forms POC (criados por: python poc_zendesk.py setup) ---

# Form agente — campos visiveis no workspace (active=true)
ZENDESK_FORM_POC=52205314865435

# Form portal — end_user_visible=true (Help Center / corretor)
ZENDESK_FORM_POC_PORTAL=52205346418459

# --- Campos customizados POC (no form acima, ja ativados) ---

# Produto (campo nativo da instancia — obrigatorio para solved)
ZENDESK_FIELD_PRODUTO=46571594520347
ZENDESK_FIELD_PRODUTO_VALOR=agrícola_

# Tipo de chamado (tagger POC)
ZENDESK_FIELD_TIPO_CHAMADO=52205300051355
ZENDESK_FIELD_TIPO_CHAMADO_VALOR=poc_agronext_suporte

# Proposta / cotacao (texto, visivel no portal)
ZENDESK_FIELD_PROPOSTA=52205313914011

# Aprovacoes REQ-09/10/11
ZENDESK_FIELD_APROVACAO_SIMPLES=52205341486491
ZENDESK_FIELD_APROVACAO_DUPLA=52205330437403
ZENDESK_FIELD_APROVACAO_NIVEL=52205330613915

# --- Opcional: tickets usados nos CLIs ---

# ZENDESK_TICKET_ID_MIN=20
# ZENDESK_TICKET_POC=27

# --- Opcional: examples/api_usage_example.py (modo nao interativo) ---

